# Copia este archivo a `.env` (renómbralo) y pega tus credenciales.
#   cp .env.example .env
# Luego edita `.env` y rellena los valores. NO subas `.env` a GitHub (ya está en .gitignore).

# --- Proveedor de imágenes ---
# El paso `generar_imagenes.py` soporta DOS proveedores intercambiables:
#   * "gemini"  -> Google AI Studio (Nano Banana). Requiere GEMINI_API_KEY.
#   * "qwen"    -> Alibaba Cloud DashScope (qwen-image-3.0 / -pro). Requiere QWEN_API_KEY (+ host).
# Elige el activo con IMAGEN_PROVEEDOR. Por defecto "gemini".
IMAGEN_PROVEEDOR=gemini

# --- Gemini / Google AI Studio (imágenes) ---
# Clave API de Google AI Studio: https://aistudio.google.com/apikey
# Es necesaria para el script `scripts/generar_imagenes.py` si IMAGEN_PROVEEDOR=gemini.
GEMINI_API_KEY=

# Modelo de imagen (Gemini).
#   * "gemini-3.1-flash-image-preview"  = Nano Banana 2 (modelo de pago / preview).
#   * "gemini-2.5-flash-image"          = Nano Banana (cuenta con free tier en AI Studio).
# Por defecto el pipeline usa "gemini-3.1-flash-image-preview". Para usar el free tier,
# déjalo como "gemini-2.5-flash-image".
NANO_BANANA_MODEL=gemini-3.1-flash-image-preview

# --- Alibaba Cloud DashScope / Qwen (imágenes) ---
# Necesarias si IMAGEN_PROVEEDOR=qwen. La clave suele venir en un CSV "Default Workspace-apiKey-.csv".
#   apiKey -> QWEN_API_KEY ; apiHost -> QWEN_API_HOST ; modelo -> QWEN_IMAGE_MODEL.
# El host apunta a tu workspace (ej.: ws-emxfi567101fw62r.ap-southeast-1.maas.aliyuncs.com).
QWEN_API_KEY=
QWEN_API_HOST=dashscope.aliyuncs.com
#   * "qwen-image-2.0"      = generación de imagen (base, free-tier friendly).
#   * "qwen-image-3.0"      = generación de imagen (base).
#   * "qwen-image-3.0-pro"  = versión pro (de pago).
QWEN_IMAGE_MODEL=qwen-image-2.0

# Máximo de peticiones por minuto a Qwen (límite del free tier de Alibaba).
#   * qwen-image-2.0 -> 2 RPM (default) ; qwen-image-3.0 -> 5 RPM.
# El script espacia las peticiones para no superar este número. Modificable por el usuario
# o por la IA a pedido.
QWEN_RPM=2

# --- TTS modular (edge-tts / Google Cloud TTS) ---
# Motor de texto-a-voz. Default del proyecto: "gcp" (Google Cloud TTS, mejor calidad).
# Valores: "gcp" (default, requiere GCP_TTS_API_KEY) o "edge" (gratis, Microsoft Edge, sin clave,
# usado solo como fallback si no hay API key o el usuario lo pide en ideación).
# El agente DEBE preguntar en Fase 1: "Uso gcp por defecto, ¿confirmas o cambias a edge?".
TTS_MOTOR=gcp

# Google Cloud Text-to-Speech (opcional, para motor "gcp").
# 1. Crea un proyecto en https://console.cloud.google.com
# 2. Habilita la API "Cloud Text-to-Speech API" (APIs y servicios -> Biblioteca)
# 3. Activa billing (el free tier mensual se mantiene: WaveNet 4M chars, Neural2 1M chars,
#    Chirp 3 HD 1M chars — aprox. 20+ horas de audio gratis al mes)
# 4. APIs y servicios -> Credenciales -> Crear credenciales -> Clave de API
GCP_TTS_API_KEY=
# Voz de Google Cloud TTS. Familias: Neural2 (ej. es-ES-Neural2-F), Wavenet (es-ES-Wavenet-C),
# Chirp3-HD (es-ES-Chirp3-HD-Aoede). Lista completa: cloud.google.com/text-to-speech/docs/voices
GCP_TTS_VOZ=es-ES-Neural2-F
# Voz de edge-tts (motor "edge").
EDGE_TTS_VOZ=es-ES-ElviraNeural
# Modelo de whisper para la transcripción: tiny/base/small/medium/large-v3.
WHISPER_MODEL=small

# --- Consistencia de imágenes (Qwen) ---
# Seed fija para todas las escenas de un video. Vacío = auto-derivada del título del guion
# (misma idea = misma seed; otra idea = otra seed). También por CLI: --seed 12345.
IMAGEN_SEED=
# Reescritura automática del prompt por parte del modelo Qwen. false (default) = respeta tu
# prompt literal -> máxima consistencia entre escenas. true = más detalle pero más varianza.
QWEN_PROMPT_EXTEND=false
