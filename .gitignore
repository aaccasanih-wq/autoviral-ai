# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist-packages/
*.egg
.venv/
venv/
env/
.conda/

# --- Virtual envs ---
.python-version
.pipenv/

# --- Data / workspace artifacts (generated media + model cache) ---
# Cubre tanto la estructura plana antigua (workspace/audio/...) como la nueva por sesión
# (workspace/<fecha>/<tema>/audio/...): "**" iguala cero o más directorios.
workspace/**/audio/*
workspace/**/transcripcion/*
workspace/**/imagenes/*
workspace/**/video/*
workspace/**/revision/*
workspace/**/guion.json
workspace/**/prompts.txt
workspace/**/referencia_*.png
workspace/**/.cache_hf/*
workspace/**/.cache_huggingface/*
!workspace/**/.gitkeep

# --- MCP / agent caches ---
.mcp/
.agents/local/
*.log

# --- Secrets / credentials (never commit API keys) ---
.env
.env.*
!.env.example
*.key
*.pem
credentials.yaml
.credentials.yaml

# --- Generated skill bundles ---
# dist/*.zip are tracked deliverable by design; keep them committed.

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
