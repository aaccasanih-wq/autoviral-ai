{
  "mcpServers": {
    "nano-banana-2": {
      "command": "npx",
      "args": ["-y", "nano-banana-2-mcp"],
      "env": {
        "GEMINI_API_KEY": "PON_AQUI_TU_GEMINI_API_KEY",
        "NANO_BANANA_MODEL": "gemini-3.1-flash-image-preview",
        "NANO_BANANA_OUTPUT_DIR": "workspace/imagenes",
        "NANO_BANANA_INLINE_IMAGE": "false"
      }
    },
    "kinocut": {
      "command": "kino",
      "args": ["--mcp"],
      "env": {}
    }
  }
}
